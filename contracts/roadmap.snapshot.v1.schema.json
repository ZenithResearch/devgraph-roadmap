{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "branding",
    "snapshot",
    "initiative",
    "groups",
    "gates",
    "claims",
    "blockers",
    "qualification",
    "tracking"
  ],
  "properties": {
    "schema": {
      "const": "roadmap.snapshot/v1"
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "mark",
        "subtitle"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "mark": {
          "type": "string",
          "minLength": 1
        },
        "subtitle": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "as_of",
        "captured_at",
        "authority",
        "sources",
        "limitations"
      ],
      "properties": {
        "as_of": {
          "type": "string",
          "minLength": 1
        },
        "captured_at": {
          "type": "string",
          "minLength": 1
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "path",
              "sha256",
              "role"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}(?![\\s\\S])"
              },
              "role": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "initiative": {
      "$ref": "#/$defs/initiative"
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "project_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "project_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
            }
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary"
      ],
      "properties": {
        "state": {
          "enum": [
            "qualified",
            "unqualified",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tracking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary"
      ],
      "properties": {
        "state": {
          "enum": [
            "current",
            "stale",
            "unknown"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:roadmap:snapshot:v1",
  "$defs": {
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legacy_status",
        "stage",
        "progress",
        "archived",
        "version",
        "workflow_id",
        "done"
      ],
      "properties": {
        "legacy_status": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "progress": {
          "type": [
            "string",
            "null"
          ]
        },
        "archived": {
          "type": "boolean"
        },
        "version": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "workflow_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "done": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary",
        "references"
      ],
      "properties": {
        "state": {
          "enum": [
            "none",
            "recorded",
            "verified"
          ]
        },
        "summary": {
          "type": "string"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "label",
              "path"
            ],
            "properties": {
              "source_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "canonical",
        "evidence",
        "acceptance",
        "blocker_ids",
        "estimate",
        "tokens"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "kind": {
          "const": "Task"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "canonical": {
          "$ref": "#/$defs/canonical"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "acceptance": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "blocker_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
          }
        },
        "estimate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hours",
            "points",
            "source_id"
          ],
          "properties": {
            "hours": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "optimistic",
                    "likely",
                    "pessimistic"
                  ],
                  "properties": {
                    "optimistic": {
                      "type": "number",
                      "minimum": 0
                    },
                    "likely": {
                      "type": "number",
                      "minimum": 0
                    },
                    "pessimistic": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "points": {
              "enum": [
                null,
                1,
                2,
                3,
                5,
                8,
                13,
                21
              ]
            },
            "source_id": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "total",
            "source_id",
            "as_of"
          ],
          "properties": {
            "coverage": {
              "enum": [
                "unobserved",
                "partial",
                "observed"
              ]
            },
            "total": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "source_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "as_of": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "canonical",
        "evidence",
        "depends_on",
        "tasks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "kind": {
          "const": "Issue"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "canonical": {
          "$ref": "#/$defs/canonical"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
          }
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      }
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "canonical",
        "evidence",
        "label",
        "issues"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "kind": {
          "const": "Project"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "canonical": {
          "$ref": "#/$defs/canonical"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        }
      }
    },
    "initiative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "description",
        "canonical",
        "evidence",
        "projects"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "kind": {
          "const": "Initiative"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "canonical": {
          "$ref": "#/$defs/canonical"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        },
        "projects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/project"
          }
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "summary",
        "requires",
        "source_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "passed",
            "unknown"
          ]
        },
        "summary": {
          "type": "string"
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
          }
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "work_id",
        "lane",
        "source_id"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "work_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        },
        "lane": {
          "enum": [
            "evidence",
            "review",
            "queued",
            "qualification"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
        }
      }
    }
  }
}

{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "default_example",
    "examples"
  ],
  "properties": {
    "schema": {
      "const": "roadmap.configuration/v1"
    },
    "default_example": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "adapter",
          "roadmap",
          "source_ids",
          "branding",
          "groups"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "enum": [
              "zendo",
              "devgraph"
            ]
          },
          "roadmap": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
            }
          },
          "branding": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "mark",
              "subtitle"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "mark": {
                "type": "string",
                "minLength": 1
              },
              "subtitle": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "project_ids"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "project_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*(?![\\s\\S])"
                  }
                }
              }
            }
          },
          "tokens": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
